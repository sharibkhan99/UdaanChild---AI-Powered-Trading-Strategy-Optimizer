<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UdaanChild Analyzer"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center" />

        <EditText
            android:id="@+id/etClientId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dhan Client ID"
            android:textColor="#FFFFFF"
            android:textColorHint="#777"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etAccessToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Access Token"
            android:textColor="#FFFFFF"
            android:textColorHint="#777"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etSymbol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Symbol (e.g. NIFTY)"
            android:textColor="#FFFFFF"
            android:textColorHint="#777"
            android:text="NIFTY"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timeframe"
            android:textColor="#00ADB5"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spTimeframe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etAsOfDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="As of Date (YYYY-MM-DD)"
            android:textColor="#FFFFFF"
            android:textColorHint="#777"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Analysis"
            android:backgroundTint="#00ADB5"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Result will appear here"
            android:textColor="#EEEEEE"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvReversals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
